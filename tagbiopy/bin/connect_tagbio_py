#!/usr/bin/env python3

import argparse
import json
from typing import Dict

from tagbiopy.utils import load_function, create_temp_file, TagbioData, TagbioResult, now, print_ts
from tagbiopy.logging import initialize_logger


def parse_arguments() -> argparse.Namespace:
    usage: Dict[str, str] = {
        'fc_data': 'JSON file specifying FC and protocol. Generated by FC.',
        'user_function': 'User function passed in a py file.',
        'output_file': 'Path to the output file.',
        'output_type': 'File type of result.'
    }

    parser = argparse.ArgumentParser()

    parser.add_argument('-d', '--fc_data', required=True, help=usage['fc_data'])
    parser.add_argument('-f', '--user_function', required=True, help=usage['user_function'])
    parser.add_argument('-t', '--output_type', required=False, help=usage['output_type'])
    parser.add_argument('-o', '--output_file', required=False, help=usage['output_file'])

    args = parser.parse_args()

    return args


def set_extension_and_path(args: argparse.Namespace) -> (str, str):
    extension = args.output_type
    path = args.output_file

    if path is None:
        path = create_temp_file(prefix='py_{}_'.format(now('_')), suffix='.temp')

    if extension is not None:
        if path.endswith('.temp'):
            path = path.replace('.temp', extension)
    return extension, path


def main():
    args = parse_arguments()

    logger = initialize_logger()

    s = 'Python command line arguments:\n' + json.dumps(vars(args), indent=2)
    logger.info(s)
    print_ts(s, flush=True)

    # Initialize tag_data
    tag_data = TagbioData(args.fc_data)

    logger.info(tag_data.fc_packet)

    # Initialize tag_result. If output path is a temp file
    extension, path = set_extension_and_path(args)
    tag_result = TagbioResult(extension=extension, path=args.output_file)

    # Load user function
    user_function = load_function(args.user_function)

    user_function(tag_data, tag_result)

    logger.info('Done')
    print_ts('Done', flush=True)


if __name__ == '__main__':
    main()
