#!/usr/bin/env python
import json
import argparse
import datetime

from tagbiopy.utils import load_function, TagbioData, TagbioResult, print_ts


def parse_arguments():
    usage = {
        'fc_data': 'JSON file specifying FC and protocol. Generated by FC.',
        'user_function': 'User function passed in a py file.',
        'output_file': 'Path to the output file.',
        'output_type': 'File type of result.'
    }

    parser = argparse.ArgumentParser()

    parser.add_argument('-d', '--fc_data', required=True, help=usage['fc_data'])
    parser.add_argument('-f', '--user_function', required=True, help=usage['user_function'])
    parser.add_argument('-o', '--output_file', required=False, help=usage['output_file'])
    parser.add_argument('-t', '--output_type', required=False, help=usage['output_type'])

    args = parser.parse_args()

    return args


def now():
    return datetime.datetime.now().strftime('%X').replace(':', '-')


def main():
    args = parse_arguments()
    s = 'Python command line arguments:\n' + json.dumps(vars(args), indent=2)
    print_ts(s, flush=True)

    # Initialize tag_data
    tag_data = TagbioData(args.fc_data)
    tag_data.entity_id = 'patient_id'

    print_ts(tag_data.fc_packet, flush=True)

    # Initialize tag_result
    tag_result = TagbioResult(extension=args.output_type, path=args.output_file)

    # Load user function
    user_function = load_function(args.user_function)

    # Execute user_function
    tag_result = user_function(tag_data, tag_result)

    # Save figure
    tag_result.save()

    print_ts('Done', flush=True)


if __name__ == '__main__':
    main()
